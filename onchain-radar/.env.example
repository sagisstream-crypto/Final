# Скопируйте в .env и заполните.

# Бесплатный ключ с https://etherscan.io/apis — с 2024-го один ключ (Etherscan V2)
# работает сразу на Ethereum, Arbitrum и остальных поддерживаемых EVM-сетях
# через параметр chainid, отдельный ключ на каждую сеть не нужен.
ETHERSCAN_API_KEY=

# Список ERC-20 контрактов через запятую: chainId:0xАдресКонтракта
# 1 = Ethereum mainnet, 42161 = Arbitrum One (полный список chainId — chains.js)
WATCHLIST=1:0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984,42161:0x912CE59144191C1204E64559FE8253a0e49E6548

# Опционально — чтобы карточки сигналов улетали в Telegram-бота.
# Бота создаёте сами через @BotFather, chat_id — свой или канала, куда бот добавлен админом.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Как часто опрашивать вотчлист, мс (по умолчанию 5 минут — Etherscan free tier это не 5 req/s не переживёт чаще на большом списке)
POLL_INTERVAL_MS=300000

# --- npm run backtest (src/backtest.js) — всё опционально, значения по умолчанию разумные ---
BACKTEST_PERIOD_DAYS=90            # сколько дней истории просмотреть
BACKTEST_SAMPLE_INTERVAL_DAYS=7    # шаг между точками сэмплирования
BACKTEST_LOOKBACK_DAYS=3           # окно переводов ДО каждой точки (имитирует "что видел бы live-сканер")
BACKTEST_FORWARD_DAYS=7,14,30      # через сколько дней после точки смотреть на доходность
BACKTEST_LARGE_TRANSFER_USD_MIN=5000
BACKTEST_SIGNAL_MIN_WALLETS=3      # порог "похоже на накопление" для сравнения групп в отчёте
